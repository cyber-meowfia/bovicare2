# ==============================================================================
# BoviCare — Environment Configuration
# ==============================================================================
# Configure your existing Supabase project connection here.
# These variables are read by server.js and initialized centrally in the frontend.
#
# IMPORTANT SECURITY NOTICE:
# - Use ONLY your publishable / anon public API key (supabase anon key).
# - NEVER put service_role keys, database passwords, or private secrets in this file
#   or in any browser-accessible code.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (publicly safe JWT)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage Bucket (optional, defaults to bovicare-private-images with fallback to udder-images)
BOVICARE_STORAGE_BUCKET=bovicare-private-images
